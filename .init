# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$PATH";

# Add a reference to .dotfiles directory
export DOTFILES=$HOME/.dotfiles

# iTerm shell integration
if [ "$TERM_PROGRAM" = "iTerm.app" ]; then
	test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
fi

# Homebrew
# This needs to be evaluated as soon as possible to enable homebrew packages
# to be accessible as if they were included in the system PATH
if [[ -f "/opt/homebrew/bin/brew" ]] then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# load zgenom
source "${HOME}/.zgenom/zgenom.zsh"
zgenom autoupdate

if ! zgenom saved; then
	zgenom load zsh-users/zsh-syntax-highlighting
	zgenom load zsh-users/zsh-completions
	zgenom load zsh-users/zsh-autosuggestions
	zgenom load Aloxaf/fzf-tab
	zgenom save
fi

# Init Oh My Posh (prompt)
if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/zen.toml)"
fi

# bun completions
[ -s "/Users/figmentfel/.bun/_bun" ] && source "/Users/figmentfel/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Add Cargo (Rust) to PATH
. "$HOME/.cargo/env"

# Add python packages to PATH
export PATH="/Users/figmentfel/Library/Python/3.9/bin/:$PATH"

# Load the shell dotfiles:
for file in ~/.dotfiles/.{config,aliases,functions}; do
	[ -r "$file" ] && [ -f "$file" ] && source "$file";
done;
unset file;
